{
  "name": "virasat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "stripe:listen": "node scripts/stripe-listen.mjs",
    "admin:create": "node --conditions=react-server --import tsx scripts/create-admin.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-email/render": "2.3.1",
    "@sentry/nextjs": "11.13.0",
    "better-auth": "1.7.26",
    "next": "16.4.6",
    "posthog-js": "1.450.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.38.1",
    "server-only": "0.0.1",
    "stripe": "23.1.0",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.23.0"
}
