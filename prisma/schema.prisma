// Virasat database schema (PostgreSQL 16, Prisma 7).
// Rules: money is integer cents (*Cents, Int) in USD, never floats.
// Tables and columns are snake_case in the database; camelCase in TypeScript.
// Extra safety rules (CHECK constraints) live in the migration SQL; see prisma/migrations.
// Order, account and admin tables are added in Steps 5, 6 and 7.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Catalogue ──────────────────────────────────────────────────────────────

enum ProductCategory {
  lehenga
  saree
  anarkali
  sherwani
  kurta_set
}

enum Gender {
  women
  men
}

enum Occasion {
  wedding
  sangeet
  mehendi
  reception
  festive
  party
}

enum ProductStatus {
  draft
  published
}

model Product {
  id                  String          @id @default(uuid(7)) @db.Uuid
  slug                String          @unique
  title               String
  description         String          @db.Text
  category            ProductCategory
  gender              Gender
  fabric              String
  work                String
  colour              String
  occasions           Occasion[]
  care                String          @db.Text
  /// Customs code for export paperwork. Required before publishing (checked in admin, Step 6).
  hsCode              String?         @map("hs_code")
  /// All-inclusive US price: duties, import taxes and express shipping included.
  priceCents          Int             @map("price_cents")
  /// "Was" price for a sale. Must be higher than priceCents (database rule).
  compareAtCents      Int?            @map("compare_at_cents")
  customFitAvailable  Boolean         @default(false) @map("custom_fit_available")
  customFitExtraCents Int             @default(0) @map("custom_fit_extra_cents")
  /// Days to make or prepare a standard-size piece before it ships.
  readyDays           Int             @map("ready_days")
  /// Days to make a custom-fit piece. Required when customFitAvailable (database rule).
  customDays          Int?            @map("custom_days")
  status              ProductStatus   @default(draft)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  images   ProductImage[]
  variants Variant[]

  @@index([status, category])
  @@index([status, createdAt(sort: Desc)])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  /// Either a site path ("/seed/x.jpg") or a full URL on the images domain (IMAGES_BASE_URL).
  url       String
  /// Required description for screen readers (database rule: not blank).
  alt       String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model Variant {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  /// Size label shown to shoppers, e.g. "M (US 8–10)".
  size      String
  sku       String  @unique
  /// Pieces in stock. Empty (null) means made to order, so never sold out.
  stock     Int?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
  @@index([productId, position])
  @@map("variants")
}
