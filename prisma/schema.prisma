// Virasat database schema (PostgreSQL 16, Prisma 7).
// Rules: money is integer cents (*Cents, Int) in USD, never floats.
// Tables and columns are snake_case in the database; camelCase in TypeScript.
// Extra safety rules (CHECK constraints) live in the migration SQL; see prisma/migrations.
// Login tables (Better Auth) arrive in Step 6; fit profiles in Step 7.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Catalogue ──────────────────────────────────────────────────────────────

enum ProductCategory {
  lehenga
  saree
  anarkali
  sherwani
  kurta_set
}

enum Gender {
  women
  men
}

enum Occasion {
  wedding
  sangeet
  mehendi
  reception
  festive
  party
}

enum ProductStatus {
  draft
  published
}

model Product {
  id                  String          @id @default(uuid(7)) @db.Uuid
  slug                String          @unique
  title               String
  description         String          @db.Text
  category            ProductCategory
  gender              Gender
  fabric              String
  work                String
  colour              String
  occasions           Occasion[]
  care                String          @db.Text
  /// Customs code for export paperwork. Required before publishing (checked in admin, Step 6).
  hsCode              String?         @map("hs_code")
  /// All-inclusive US price: duties, import taxes and express shipping included.
  priceCents          Int             @map("price_cents")
  /// "Was" price for a sale. Must be higher than priceCents (database rule).
  compareAtCents      Int?            @map("compare_at_cents")
  customFitAvailable  Boolean         @default(false) @map("custom_fit_available")
  customFitExtraCents Int             @default(0) @map("custom_fit_extra_cents")
  /// Days to make or prepare a standard-size piece before it ships.
  readyDays           Int             @map("ready_days")
  /// Days to make a custom-fit piece. Required when customFitAvailable (database rule).
  customDays          Int?            @map("custom_days")
  status              ProductStatus   @default(draft)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  images     ProductImage[]
  variants   Variant[]
  orderItems OrderItem[]

  @@index([status, category])
  @@index([status, createdAt(sort: Desc)])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  /// Either a site path ("/seed/x.jpg") or a full URL on the images domain (IMAGES_BASE_URL).
  url       String
  /// Required description for screen readers (database rule: not blank).
  alt       String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model Variant {
  id         String      @id @default(uuid(7)) @db.Uuid
  productId  String      @map("product_id") @db.Uuid
  /// Size label shown to shoppers, e.g. "M (US 8–10)".
  size       String
  sku        String      @unique
  /// Pieces in stock. Empty (null) means made to order, so never sold out.
  stock      Int?
  position   Int         @default(0)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, size])
  @@index([productId, position])
  @@map("variants")
}

// ─── Orders (Step 5) ────────────────────────────────────────────────────────

/// Order lifecycle. Changes only through lib/order-status.ts (see the v1 spec, section 7).
enum OrderStatus {
  paid
  confirmed
  in_production
  shipped
  delivered
  cancelled
  refunded
}

/// The bag as priced by our server, saved while the shopper is on Stripe's payment page.
/// The Stripe webhook turns it into an order. Deleted after 7 days by the cron job.
model CheckoutDraft {
  id              String   @id @default(uuid(7)) @db.Uuid
  /// Validated, server-priced lines (see lib/checkout.ts → DraftLine).
  items           Json
  subtotalCents   Int      @map("subtotal_cents")
  stripeSessionId String?  @unique @map("stripe_session_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("checkout_drafts")
}

model Order {
  id                    String       @id @default(uuid(7)) @db.Uuid
  /// Shown to customers, e.g. VRS-1001. From a database sequence (see migration).
  number                String       @unique @default(dbgenerated("('VRS-'::text || nextval('order_number_seq'::regclass))"))
  status                OrderStatus  @default(paid)
  email                 String
  phone                 String?
  customerName          String       @map("customer_name")
  /// { line1, line2, city, state, postalCode, country }
  shippingAddress       Json         @map("shipping_address")
  currency              String       @default("USD") @db.Char(3)
  subtotalCents         Int          @map("subtotal_cents")
  /// Promotion codes and store credit applied on Stripe's page.
  discountCents         Int          @default(0) @map("discount_cents")
  shippingCents         Int          @default(0) @map("shipping_cents")
  /// What the customer paid: subtotal − discount + shipping (database rule).
  totalCents            Int          @map("total_cents")
  /// One order per Stripe Checkout Session: this is what makes the webhook safe to repeat.
  stripeSessionId       String       @unique @map("stripe_session_id")
  stripePaymentIntentId String?      @unique @map("stripe_payment_intent_id")
  /// Secret for the order-status link in emails (Step 7).
  accessToken           String       @unique @map("access_token")
  courier               String?
  trackingNumber        String?      @map("tracking_number")
  confirmationSentAt    DateTime?    @map("confirmation_sent_at")
  adminAlertSentAt      DateTime?    @map("admin_alert_sent_at")
  /// The status whose customer email (shipped, delivered, cancelled) has been sent. The cron
  /// job resends it while this differs from `status` (lib/order-emails.tsx).
  statusEmailSentFor    OrderStatus? @map("status_email_sent_for")
  paidAt                DateTime     @default(now()) @map("paid_at")
  confirmedAt           DateTime?    @map("confirmed_at")
  inProductionAt        DateTime?    @map("in_production_at")
  shippedAt             DateTime?    @map("shipped_at")
  deliveredAt           DateTime?    @map("delivered_at")
  cancelledAt           DateTime?    @map("cancelled_at")
  refundedAt            DateTime?    @map("refunded_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  items  OrderItem[]
  events OrderEvent[]

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@map("orders")
}

/// What was bought, copied at purchase time so later product edits never change past orders.
model OrderItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  titleSnapshot  String   @map("title_snapshot")
  imageSnapshot  String?  @map("image_snapshot")
  /// Size label at purchase, or null for custom fit.
  size           String?
  isCustom       Boolean  @default(false) @map("is_custom")
  /// Custom-fit measurements copied at purchase (form arrives in Step 7).
  measurements   Json?
  unitPriceCents Int      @map("unit_price_cents")
  quantity       Int
  productionDays Int      @map("production_days")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant        Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

/// Every status change and note, for the order timeline and the admin.
model OrderEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus? @map("to_status")
  note       String?
  /// "stripe", "system", or an admin user id (Step 6).
  actor      String
  createdAt  DateTime     @default(now()) @map("created_at")
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ─── Login (Better Auth, lib/auth.ts) ──────────────────────────────────────
// Column names follow Better Auth's schema; the adapter checks them on start-up.
// Admins sign in with a password plus an authenticator code (TOTP). Only
// `pnpm admin:create` makes admins. Customers sign in with email codes or Google (Step 7).

enum UserRole {
  customer
  admin
}

model User {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  role             UserRole @default(customer)
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]
  adminLogs  AdminLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A way to sign in: "credential" (password hash, admins only) or a provider like Google.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Short-lived values: pending two-factor sign-ins now, email codes in Step 7.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

/// The authenticator-app secret and backup codes, both encrypted with BETTER_AUTH_SECRET.
model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([secret])
  @@map("two_factors")
}

// ─── Admin ──────────────────────────────────────────────────────────────────

/// Every admin change: who, when, from where, and the record before and after (CLAUDE.md
/// rule 7). Written in the same transaction as the change (lib/admin-log.ts).
model AdminLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  /// What happened, e.g. "order.status", "order.note", "product.update".
  action      String
  /// What it happened to: "order" or "product".
  entity      String
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")
  /// Admins with log entries can't be deleted, so the history stays complete.
  admin       User     @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("admin_log")
}
