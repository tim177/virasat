# Copy this file to .env and fill in the values. Never commit .env.

# Local database from docker-compose.yml (pnpm db:up). On the server this is a different, strong password.
DATABASE_URL="postgresql://virasat:virasat_local_dev@localhost:5432/virasat"

# Public address of the shop (canonical links, sitemap, structured data). No trailing slash.
SITE_URL="http://localhost:3000"

# Only "true" on the live shop. Anywhere else, search engines are told to stay away.
ALLOW_INDEXING=""

# Where uploaded product photos are served from (Cloudflare R2 public bucket on your own
# subdomain), e.g. "https://images.example.com". Leave empty locally: sample photos are in /public/seed.
IMAGES_BASE_URL=""

# Sample products are only seeded into a local database. Set to "true" only for a staging
# database. Never for the live shop.
ALLOW_SEED=""

# Shows /dev/components in a production build (it always shows in `pnpm dev`).
# Only for CI and local testing. Never set this on the live server.
ENABLE_DEV_PAGES=""

# Stripe (payments). Use test keys (sk_test_...) everywhere except the live shop.
# Locally, STRIPE_WEBHOOK_SECRET comes from `pnpm stripe:listen` (it prints a whsec_ secret).
# On a server, it comes from Dashboard → Developers → Webhooks → your endpoint.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email. Without RESEND_API_KEY, emails are saved to .outbox/ instead of being sent.
# On the live server RESEND_API_KEY is required (EMAIL_OUTBOX must stay empty there).
RESEND_API_KEY=""
EMAIL_FROM="Virasat <orders@example.com>"
EMAIL_OUTBOX="true"
# Gets a "new order" email for every order. Leave empty to skip.
ADMIN_ALERT_EMAIL=""

# Shared secret for the scheduled jobs (/api/cron/*). Any long random string.
CRON_SECRET=""

# Sentry (error alerts). Leave empty to keep Sentry off.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
# Only needed on the server/CI to upload source maps:
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# PostHog (analytics). Leave empty to keep PostHog off.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
