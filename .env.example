# Copy this file to .env and fill in the values. Never commit .env.

# Local database from docker-compose.yml (pnpm db:up). On the server this is a different, strong password.
DATABASE_URL="postgresql://virasat:virasat_local_dev@localhost:5432/virasat"

# Public address of the shop (canonical links, sitemap, structured data). No trailing slash.
SITE_URL="http://localhost:3000"

# Only "true" on the live shop. Anywhere else, search engines are told to stay away.
ALLOW_INDEXING=""

# Product photos. With all five R2 values set, admin uploads go to Cloudflare R2 and are served
# from IMAGES_BASE_URL (the bucket's public custom domain, e.g. "https://images.example.com").
# Leave them all empty to keep uploads in a local folder (UPLOADS_DIR, default ./uploads),
# served by the app at /uploads/... (local development, CI, or a server before R2 exists).
IMAGES_BASE_URL=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
UPLOADS_DIR=""

# Sample products are only seeded into a local database. Set to "true" only for a staging
# database. Never for the live shop.
ALLOW_SEED=""

# Shows /dev/components in a production build (it always shows in `pnpm dev`).
# Only for CI and local testing. Never set this on the live server.
ENABLE_DEV_PAGES=""

# Stripe (payments). Use test keys (sk_test_...) everywhere except the live shop.
# Locally, STRIPE_WEBHOOK_SECRET comes from `pnpm stripe:listen` (it prints a whsec_ secret).
# On a server, it comes from Dashboard → Developers → Webhooks → your endpoint.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email. Without RESEND_API_KEY, emails are saved to .outbox/ instead of being sent.
# On the live server RESEND_API_KEY is required (EMAIL_OUTBOX must stay empty there).
RESEND_API_KEY=""
EMAIL_FROM="Virasat <orders@example.com>"
EMAIL_OUTBOX="true"
# Gets a "new order" email for every order. Leave empty to skip.
ADMIN_ALERT_EMAIL=""

# Shared secret for the scheduled jobs (/api/cron/*). Any long random string.
CRON_SECRET=""

# Login (Better Auth): signs login cookies and encrypts authenticator secrets. Required.
# Generate with: openssl rand -base64 32. Changing it signs everyone out and breaks existing
# authenticator setups (run `pnpm admin:create --reset` for each admin afterwards).
BETTER_AUTH_SECRET=""

# Local development only: every sign-in code accepts this (customer email codes and the admin
# authenticator step), so you need no inbox or phone. Real codes keep working too. Ignored when
# NODE_ENV=production (next start, Docker, servers) or when DATABASE_URL isn't on this computer.
DEV_VERIFICATION_CODE="000000"

# Cloudflare Turnstile ("are you human?" check) on the login forms. Off while either key is empty.
# Local testing: Cloudflare's always-pass test keys below. Live keys: Cloudflare dashboard →
# Turnstile → Add widget (free), with your domain as the hostname.
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# "Continue with Google" on /login. Hidden while either value is empty.
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: <SITE_URL>/api/auth/callback/google (e.g. http://localhost:3000/...).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Fit-call booking page for custom-fit orders (Cal.com, free plan), e.g.
# "https://cal.com/your-name/fit-call". Must start with https://. Order emails, the order pages and
# the daily reminder link to it with the customer's name, email and order number filled in.
# Empty: they say "we'll email you to arrange a time" instead.
CALCOM_FIT_CALL_URL=""

# Sentry (error alerts). Leave empty to keep Sentry off.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
# Only needed on the server/CI to upload source maps:
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# PostHog (analytics). Leave empty to keep PostHog off.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Local dev admin, filled in by `pnpm admin:dev` (sign-in code: `pnpm admin:code`).
# Local development only: never put these on a server. Servers use `pnpm admin:create`.
ADMIN_EMAIL="admin@virasat.local"
ADMIN_NAME="Virasat Admin"
ADMIN_PASSWORD=""
ADMIN_TOTP_SECRET=""

# ─── Server only (docker-compose.prod.yml, deploy/README.md) ───────────────────────────────
# Not needed for local development. On the server, DATABASE_URL is set by Docker Compose.
# Database password: `openssl rand -hex 24` (hex only, so it is safe inside URLs).
POSTGRES_PASSWORD=""
# Port for Postgres on the server's own loopback (the build reads the catalogue through it).
POSTGRES_HOST_PORT="5432"
# The shop's address and the bare domain that redirects to it.
SITE_DOMAIN="www.example.com"
APEX_DOMAIN="example.com"
# HTTPS certificate for Caddy: Cloudflare Origin Certificate files in deploy/certs/.
CADDY_TLS="/certs/origin.pem /certs/origin-key.pem"
HSTS="max-age=31536000"
HTTP_PORT="80"
HTTPS_PORT="443"
# Nightly backups (scripts/backup.sh): kept 7 days on the server, copied to this Cloud Storage
# bucket (which keeps 30 days). Leave BACKUP_BUCKET empty to keep backups on the server only.
BACKUP_DIR="/var/backups/virasat"
BACKUP_BUCKET=""
