# Local test of the production setup (deploy/README.md). Copy to deploy/local.env and fill in:
# POSTGRES_PASSWORD and CRON_SECRET with `openssl rand -hex 24`, BETTER_AUTH_SECRET with
# `openssl rand -base64 32`, and the Stripe TEST keys from your .env.
SITE_URL="https://localhost:8443"
SITE_DOMAIN="localhost"
APEX_DOMAIN="127.0.0.1"
CADDY_TLS="internal"
HSTS="max-age=0"
HTTP_PORT="8080"
HTTPS_PORT="8443"
POSTGRES_PASSWORD=""
POSTGRES_HOST_PORT="55432"
BETTER_AUTH_SECRET=""
CRON_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
EMAIL_OUTBOX="true"
EMAIL_FROM="Virasat <orders@example.com>"
ALLOW_SEED="true"
BACKUP_DIR="./backups"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
