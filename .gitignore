# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real values stay on your machine / the server; the example is committed
.env*
!.env.example

# prisma generated client (rebuilt by `pnpm install`)
/lib/generated/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# emails written locally instead of sent (no RESEND_API_KEY)
/.outbox/

# product photos uploaded locally when R2 is not set up (lib/storage.ts)
/uploads/

# server and local production-test files (deploy/README.md)
/deploy/local.env
/deploy/certs/
/backups/
